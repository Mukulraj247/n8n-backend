# JobRight login credentials (used by the headless-browser login)
JOBRIGHT_EMAIL=you@example.com
JOBRIGHT_PASSWORD=your-password

# HTTP server port
PORT=8787

# Shared secret required in the `x-api-key` header (or `?key=`) to call the API.
# Leave empty to disable auth (NOT recommended outside local dev).
N8N_SHARED_SECRET=change-me-to-a-long-random-string

# How long to trust a cached session before allowing a refresh (ms). Default 30 min.
SESSION_TTL_MS=1800000

# Refresh this long before the cookie's own expiry (ms). Default 1 day.
EXPIRY_BUFFER_MS=86400000

# Set to "false" to watch the browser during local debugging.
HEADLESS=true
